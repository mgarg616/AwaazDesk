# =====================================================================
# AwaazDesk - AI Voice Grievance Intelligence System
# Configuration & API Credentials Template
# Copy this file to .env and fill in your values.
# =====================================================================

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
SQLITE_DB_PATH=data/awaazdesk.db

# Backend API URL accessed by Streamlit Frontend
API_BASE_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------
# Gnani.ai API Configuration
# ---------------------------------------------------------------------
# AwaazDesk uses the official api.vachana.ai endpoints (verified from
# Gnani developer documentation).
#
# You can use ONE shared API key for both STT and TTS (recommended):
#   GNANI_API_KEY=<your_key_with_stt_and_tts_scopes>
#
# Or set per-service keys if you have separate keys:
#   GNANI_PRISMA_API_KEY=<your_stt_key>
#   GNANI_TIMBRE_API_KEY=<your_tts_key>
#
# If none are set, AwaazDesk runs in clearly-labelled Placeholder Mode.
# ---------------------------------------------------------------------

# Shared key (covers both STT + TTS scopes) — recommended
GNANI_API_KEY=

# Per-service overrides (optional; leave blank to use GNANI_API_KEY above)
GNANI_PRISMA_API_KEY=
GNANI_TIMBRE_API_KEY=

# ---------------------------------------------------------------------
# Gnani.ai Prisma Speech-to-Text (ASR) — Prisma v3
# Auth  : X-API-Key-ID header (single header; no token/bearer required)
# Model : prisma-v3.0
# Lang  : indic-auto (auto-detects Hindi, English, Hinglish + 7 more)
# ---------------------------------------------------------------------
# Leave blank to use the verified default endpoint:
GNANI_PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3

# Legacy variable — preserved for .env compatibility but NOT used in auth.
# Official Gnani v3 auth requires only X-API-Key-ID; no token needed.
GNANI_PRISMA_TOKEN=

# ---------------------------------------------------------------------
# Gnani.ai Timbre Text-to-Speech — Timbre v3
# Auth    : X-API-Key-ID header (same key as STT)
# Model   : timbre-v3.0
# Voices  : Shivani, Nalini, Avinash, Prakash, Lakshmi, Devansh, etc.
# Response: Raw binary audio/wav (not base64 JSON)
# ---------------------------------------------------------------------
# Leave blank to use the verified default endpoint:
GNANI_TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference

# ---------------------------------------------------------------------
# Gnani.ai Evon Sovereign Indic LLM (Artha Stack) — Evon v3.3
# Auth    : X-API-Key-ID header (same key or dedicated LLM scope)
# Model   : gnani-evon-v3.3 / gnani/gnani-evon-v3.3-30B-A3B
# Purpose : Sovereign Indic reasoning, nuance interpretation & officer actions
# ---------------------------------------------------------------------
GNANI_EVON_API_KEY=
GNANI_EVON_ENDPOINT=https://api.vachana.ai/v1/chat/completions
GNANI_EVON_MODEL=gnani-evon-v3.3

# ---------------------------------------------------------------------
# Security & JWT Authentication Configuration
# ---------------------------------------------------------------------
# Cryptographically random 256-bit secret key (minimum 32 characters).
# Generate a strong key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_secure_random_256_bit_secret_key_minimum_32_chars_here

# JWT Algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Administrative access token lifetime in minutes (default: 60 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional initial admin bootstrapping on first clean database initialization:
# If left blank, you must provision the initial administrator via CLI:
# python -m backend.security.create_admin
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

